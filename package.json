{
    "name": "crypto-lab",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "check": "biome check --write --unsafe src frontend/src",
        "build": "esbuild --bundle --minify --charset=utf8 --platform=node --format=esm --packages=external --outfile=dist/index.js src/index.ts",
        "serve": "node --run build && node dist/index.js",
        "dev": "tsx watch src/index.ts",
        "generate": "drizzle-kit generate",
        "migrate": "drizzle-kit migrate",
        "archive": "rm -f crypto-lab.7z && 7z a -mx9 crypto-lab.7z . -xr!.git -xr!database/database.db -xr!database/database.db-shm -xr!database/database.db-wal -xr!dist -xr!drizzle -xr!frontend -xr!node_modules -xr!storage -xr!config.yaml -xr!deploy.cmd -xr!pnpm-lock.yaml",
        "unarchive": "rm -rf public && 7z x -y crypto-lab.7z"
    },
    "dependencies": {
        "@hono/node-server": "^2.1.1",
        "@hono/zod-validator": "^0.9.1",
        "@napi-rs/blake-hash": "^1.4.0",
        "@node-rs/argon2": "^2.2.0",
        "@node-rs/xxhash": "^1.7.7",
        "adm-zip": "^0.6.0",
        "better-sqlite3": "^13.0.3",
        "csv-stringify": "^6.8.3",
        "drizzle-orm": "^0.45.2",
        "exit-hook": "^5.1.0",
        "hono": "^4.13.7",
        "hono-rate-limiter": "^0.5.4",
        "js-yaml": "^5.4.1",
        "node-stream-zip": "^1.16.0",
        "nodemailer": "^10.0.0",
        "string-argv": "^0.3.2",
        "wretch": "^3.0.9",
        "zod": "^4.5.4",
        "zod-validation-error": "^5.0.0"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.12",
        "@commitlint/cli": "^21.2.2",
        "@commitlint/config-conventional": "^21.2.2",
        "@types/adm-zip": "^0.5.8",
        "@types/better-sqlite3": "^9.6.0",
        "@types/js-yaml": "^4.0.9",
        "@types/node": "^26.4.1",
        "@types/nodemailer": "^8.0.1",
        "drizzle-kit": "^0.31.10",
        "esbuild": "^0.28.2",
        "lefthook": "^2.1.12",
        "tsx": "^4.23.13"
    }
}
